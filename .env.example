# NALLU TECH - Environment Variables Template
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Copy the Project URL and anon public key from Project Settings > Data API
# 3. Copy this file to .env and fill in your values
# NOTE: Never expose your service_role secret key in frontend code!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
